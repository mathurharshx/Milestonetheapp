{
  "expo": {
    "name": "Milestone",
    "slug": "milestone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "milestone",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mathurharsh.milestone",
      "buildNumber": "2",
      "appleTeamId": "HV4NTX4D65",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mathurharsh.milestone",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-splash.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#222222"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8aa8be76-01b3-4358-8add-ae379af98dc3"
      }
    },
    "owner": "harshappdevelopment"
  }
}